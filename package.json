{
  "name": "@domaindetails/whois-parser",
  "version": "1.2.0",
  "description": "Comprehensive WHOIS parser with support for 169 country-code TLDs (ccTLDs)",
  "type": "module",
  "main": "whois-parser.js",
  "files": [
    "whois-parser.js",
    "field-mappings.js",
    "status-codes.js",
    "whois_dict.json",
    "fetch-iana-servers.js",
    "example.js"
  ],
  "exports": {
    ".": "./whois-parser.js",
    "./status-codes": "./status-codes.js",
    "./field-mappings": "./field-mappings.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "node test-live.js",
    "test:sample": "node test-live.js --sample",
    "sync-iana": "node fetch-iana-servers.js",
    "sync-iana:dry-run": "node fetch-iana-servers.js --dry-run"
  },
  "dependencies": {},
  "devDependencies": {
    "vitest": "^2.1.0"
  },
  "keywords": [
    "whois",
    "parser",
    "ccTLD",
    "domain",
    "dns",
    "registry",
    "international",
    "japan",
    "korea",
    "russia",
    "europe"
  ],
  "author": "Simple Bytes LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplebytes-com/whois-parser.git"
  },
  "homepage": "https://github.com/simplebytes-com/whois-parser#readme",
  "bugs": {
    "url": "https://github.com/simplebytes-com/whois-parser/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
